{
  "name": "snnlab-docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "bun run --bun astro build",
    "dev": "bun run --bun astro dev",
    "start": "bun run preview",
    "test": "bun test scripts",
    "test:animation": "bun scripts/sync-animated-neuron.ts && bun scripts/check-neuron-replay.ts",
    "types:check": "bun run --bun astro check",
    "preview": "bun run --bun astro preview",
    "deploy:cloudflare": "bun run build && bunx --bun wrangler deploy",
    "sync:content": "bun scripts/sync-content.ts"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/mdx": "8.0.2",
    "@astrojs/react": "7.0.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.5",
    "cn": "^0.3.0",
    "fumadocs-core": "16.15.18",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.15.18",
    "katex": "^0.16.22",
    "lucide-react": "^1.47.0",
    "pixi.js": "8.22.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.0"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2"
}
